{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speedy",
  "version": "0.1.0",
  "identifier": "dev.brecht.speedy",
  "build": {
    "beforeDevCommand": "./scripts/build-agent.sh --dev && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "./scripts/build-agent.sh && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Speedy",
        "label": "main",
        "width": 1440,
        "height": 920,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/speedy-agent"
    ]
  }
}
